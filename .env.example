# DataForge local environment template
# Copy this file to .env and replace values locally.
# Never commit real credentials.

# PostgreSQL
# Use localhost when running DataForge Python code from the host machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dataforge
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=change_me_postgres

# MinIO
# Use localhost when running DataForge Python code from the host machine.
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=dataforge
MINIO_ROOT_PASSWORD=change_me_minio

# Data Lake buckets
MINIO_BUCKET_BRONZE=dataforge-bronze
MINIO_BUCKET_SILVER=dataforge-silver
MINIO_BUCKET_QUARANTINE=dataforge-quarantine
MINIO_BUCKET_GOLD=dataforge-gold

#Airflow
AIRFLOW_JWT_SECRET=change_me_airflow_jwt_secret
