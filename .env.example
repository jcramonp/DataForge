# DataForge local environment template
# Copy this file to .env and replace values locally.
# Never commit real credentials.
# Other environments: config/environments/test.env (CI) and
# config/environments/aws.env.example (AWS reference deployment).

# Runtime environment: local | test | aws
DATAFORGE_ENV=local
# Logging: level and format (text = human readable, json = structured)
DATAFORGE_LOG_LEVEL=INFO
DATAFORGE_LOG_FORMAT=text

# PostgreSQL
# Use localhost when running DataForge Python code from the host machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dataforge
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=change_me_postgres

# MinIO
# Use localhost when running DataForge Python code from the host machine.
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=dataforge
MINIO_ROOT_PASSWORD=change_me_minio

# Data Lake buckets
MINIO_BUCKET_BRONZE=dataforge-bronze
MINIO_BUCKET_SILVER=dataforge-silver
MINIO_BUCKET_QUARANTINE=dataforge-quarantine
MINIO_BUCKET_GOLD=dataforge-gold

# Airflow
AIRFLOW_JWT_SECRET=change_me_airflow_jwt_secret
AIRFLOW_PORT=8080
# Login for the Airflow UI/REST API (written to the simple auth manager at startup)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow
# Used by python -m src.orchestration.airflow_client (and the control-plane API) to trigger runs
AIRFLOW_API_URL=http://localhost:8080

# Copilot: real LLM uses Bedrock Converse. No automatic deterministic fallback.
DATAFORGE_COPILOT_MODEL_ID=
AWS_DEFAULT_REGION=us-east-1
# Optional locally; required shared secret for multiple API workers (32+ random characters).
DATAFORGE_COPILOT_SIGNING_KEY=
# AWS credentials use the SDK chain (AWS_PROFILE, env credentials or IAM role).
