# DataForge "test" environment: CI and local integration tests.
# Non-secret throwaway credentials for disposable service containers only.
# Used by .github/workflows/ci.yml and DATAFORGE_ENV_FILE=config/environments/test.env.
# Ports stay below 49152: Windows/Hyper-V reserves blocks of the dynamic range.
DATAFORGE_ENV=test
DATAFORGE_LOG_LEVEL=INFO
DATAFORGE_LOG_FORMAT=json

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=dataforge_test
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=dataforge_test

MINIO_ENDPOINT=http://localhost:19000
MINIO_ROOT_USER=dataforge
MINIO_ROOT_PASSWORD=dataforge_test

MINIO_BUCKET_BRONZE=dataforge-bronze
MINIO_BUCKET_SILVER=dataforge-silver
MINIO_BUCKET_QUARANTINE=dataforge-quarantine
MINIO_BUCKET_GOLD=dataforge-gold
