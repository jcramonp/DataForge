# DataForge "aws" environment template (reference deployment, #28).
# Do NOT store real values in Git. Inject these as task/container environment
# variables; take secrets (POSTGRES_PASSWORD) from AWS Secrets Manager or SSM.
# See docs/operations/configuration.md for the IAM permissions each service needs.
DATAFORGE_ENV=aws
DATAFORGE_LOG_LEVEL=INFO
DATAFORGE_LOG_FORMAT=json

# Amazon RDS for PostgreSQL (private subnet, TLS required)
POSTGRES_HOST=<rds-endpoint>.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=dataforge
POSTGRES_USER=dataforge_app
POSTGRES_PASSWORD=<injected-from-secrets-manager>
POSTGRES_SSLMODE=require

# Amazon S3: leave MINIO_ENDPOINT and static keys unset so boto3 uses the
# task/instance IAM role.
AWS_REGION=us-east-1
MINIO_BUCKET_BRONZE=<prefix>-dataforge-bronze
MINIO_BUCKET_SILVER=<prefix>-dataforge-silver
MINIO_BUCKET_QUARANTINE=<prefix>-dataforge-quarantine
MINIO_BUCKET_GOLD=<prefix>-dataforge-gold
